# fogos — example configuration
#
# Copy to .env and edit:  cp .env.example .env
# .env is git-ignored (see .gitignore) — never commit a real token.
#
# Nothing loads .env automatically. Use it with one of:
#   docker run --env-file .env -p 8888:8888 ghcr.io/rodolfonuneslopes/fogos:latest
#   set -a; . ./.env; set +a; make run
#   docker compose up          # only if docker-compose.yml declares `env_file: .env`
#
# In Kubernetes none of this applies: FOGOS_TOKEN comes from a Secret
# referenced via secretKeyRef. See implementation-docs/KUBERNETES_DEPLOYMENT.md.
#
# Full reference: README.md#configuration

# Address the server listens on.
LISTEN_ADDR=:8888

# Base URL of the upstream fogos.pt API.
# Override only to point at a different endpoint (e.g. a test double).
FOGOS_BASE_URL=https://api.fogos.pt


# --- Mode: pick one -----------------------------------------------------
#
# 1. Real API, no auth — the default. The fogos.pt API is public, so
#    leaving FOGOS_TOKEN empty is a fully working setup.
#
# 2. Real API, authenticated — set FOGOS_TOKEN. It is sent upstream as both
#    X-API-KEY (what the gateway enforces) and FOGOS-PT-AUTH (what fogos.pt
#    documents), from the server only. It is never exposed to the browser:
#    the SPA talks exclusively to this server.
#
# 3. Mock — set FOGOS_MOCK=true. No network calls at all, for offline UI
#    work. Most concelhos return two sample incidents; Évora returns an
#    empty list so you can exercise the "no active fires" state.
#
# FOGOS_MOCK is checked first, so it wins if both are set.

# Empty means "no auth" — identical to leaving it unset.
FOGOS_TOKEN=

# Only the exact string "true" enables mock mode; anything else is off.
FOGOS_MOCK=false
